# Church Digital Platform — Single-Church Pilot Configuration Template
# Copy this file to .env or export variables into your host environment.
# DO NOT commit production credentials or actual private keys to source control.

ENVIRONMENT=Production
API_PORT=8080
API_ISSUER=http://localhost:8080

# PostgreSQL Configuration
DB_PORT=5432
POSTGRES_DB=church_pilot
POSTGRES_USER=church_admin
POSTGRES_PASSWORD=replace_with_strong_password_in_pilot

# RSA RS256 Private Key for Token Signing (PEM format)
# Generate with: openssl genrsa -out private_key.pem 2048
RSA_PRIVATE_KEY_PEM=
